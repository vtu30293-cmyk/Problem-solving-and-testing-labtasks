import java.util.*;

class Driver {
    String name;

    Driver(String name) {
        this.name = name;
    }
}

class Rider {
    String name;

    Rider(String name) {
        this.name = name;
    }
}

class Vehicle {
    String number;

    Vehicle(String number) {
        this.number = number;
    }
}

// Parent Trip class
class Trip {
    double distance;

    Trip(double distance) throws Exception {
        if (distance <= 0) {
            throw new Exception("Invalid distance");
        }
        this.distance = distance;
    }

    double calculateFare() {
        return 0;
    }
}

// Bike ride
class Bike extends Trip {

    Bike(double distance) throws Exception {
        super(distance);
    }

    @Override
    double calculateFare() {
        return distance * 5;
    }
}

// Cab ride
class Cab extends Trip {

    Cab(double distance) throws Exception {
        super(distance);
    }

    @Override
    double calculateFare() {
        return distance * 12;
    }
}

// Auto ride
class Auto extends Trip {

    Auto(double distance) throws Exception {
        super(distance);
    }

    @Override
    double calculateFare() {
        return distance * 12;
    }
}

public class Solution {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {

            String type = sc.next();
            double distance = sc.nextDouble();

            try {

                Trip trip;

                if (type.equalsIgnoreCase("Bike")) {
                    trip = new Bike(distance);
                }
                else if (type.equalsIgnoreCase("Cab")) {
                    trip = new Cab(distance);
                }
                else if (type.equalsIgnoreCase("Auto")) {
                    trip = new Auto(distance);
                }
                else {
                    throw new Exception("Invalid ride type");
                }

                System.out.println((int)trip.calculateFare());

            }
            catch (Exception e) {
                System.out.println("Invalid booking");
            }
        }

        sc.close();
    }
}
