import java.io.*;
import java.util.*;

public class Solution {

    static int[] manacher(String s) {
        int n = s.length();
        int[] p = new int[n];

        int l = 0, r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 1 : Math.min(p[l + r - i], r - i + 1);

            while (i - k >= 0 && i + k < n &&
                   s.charAt(i - k) == s.charAt(i + k)) {
                k++;
            }

            p[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        return p;
    }

    static int[] buildSparse(int[] a) {
        int n = a.length;
        int log = 1;

        while ((1 << log) <= n)
            log++;

        int[][] st = new int[log][n];

        for (int i = 0; i < n; i++)
            st[0][i] = a[i];

        for (int j = 1; j < log; j++) {
            for (int i = 0; i + (1 << j) <= n; i++) {
                st[j][i] = Math.max(
                    st[j - 1][i],
                    st[j - 1][i + (1 << (j - 1))]
                );
            }
        }

        return new int[] { n, log };
    }

    static int[][] sparse;

    static int query(int l, int r) {
        if (l > r)
            return 0;

        int len = r - l + 1;
        int k = 31 - Integer.numberOfLeadingZeros(len);

        return Math.max(
            sparse[k][l],
            sparse[k][r - (1 << k) + 1]
        );
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine());
        String s = br.readLine();

        // Duplicate the string
        String doubled = s + s;

        /*
         * Transform:
         * character -> actual character
         * separator -> '#'
         *
         * Example:
         * abc -> #a#b#c#
         */
        StringBuilder t = new StringBuilder();

        for (int i = 0; i < doubled.length(); i++) {
            t.append('#');
            t.append(doubled.charAt(i));
        }
        t.append('#');

        int[] radius = manacher(t.toString());

        int m = radius.length;

        int log = 1;
        while ((1 << log) <= m)
            log++;

        sparse = new int[log][m];

        for (int i = 0; i < m; i++)
            sparse[0][i] = radius[i];

        for (int j = 1; j < log; j++) {
            for (int i = 0; i + (1 << j) <= m; i++) {
                sparse[j][i] = Math.max(
                    sparse[j - 1][i],
                    sparse[j - 1][i + (1 << (j - 1))]
                );
            }
        }

        StringBuilder ans = new StringBuilder();

        for (int start = 0; start < n; start++) {

            // Window representing this rotation
            int left = 2 * start + 1;
            int right = 2 * (start + n - 1) + 1;

            int low = 1;
            int high = n;
            int best = 1;

            while (low <= high) {

                int len = (low + high) / 2;

                int L = left + len - 1;
                int R = right - len + 1;

                if (L <= R && query(L, R) >= len) {
                    best = len;
                    low = len + 1;
                } else {
                    high = len - 1;
                }
            }

            ans.append(best).append('\n');
        }

        System.out.print(ans);
    }
}
