import java.util.*;

public class RealTimeStreamAnalyticsEngine {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        Map<String, List<Integer>> map = new HashMap<>();

        for (int i = 0; i < n; i++) {
            String id = sc.next();
            int temp = sc.nextInt();

            if (temp > 50)
                map.computeIfAbsent(id, k -> new ArrayList<>()).add(temp);
        }

        List<String> sensors = new ArrayList<>(map.keySet());

        sensors.sort((a, b) -> {
            double avgA = map.get(a).stream().mapToInt(x -> x).average().getAsDouble();
            double avgB = map.get(b).stream().mapToInt(x -> x).average().getAsDouble();
            return Double.compare(avgB, avgA);
        });

        for (String id : sensors) {
            double avg = map.get(id).stream().mapToInt(x -> x).average().getAsDouble();
            System.out.println(id + " " + avg);
        }
    }
}
